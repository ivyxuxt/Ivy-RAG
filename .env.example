# Mistral AI
MISTRAL_API_KEY=your_key_here
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest

# Retrieval tuning
TOP_K=5
DENSE_TOPK=50
BM25_TOPK=50
RRF_K=60
MMR_LAMBDA=0.7
SIMILARITY_THRESHOLD_TOP1=0.75
SIMILARITY_THRESHOLD_AVG3=0.72
SENTENCE_EVIDENCE_THRESHOLD=0.50

# Chunking
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
MIN_CHUNK_CHARS=300

# BM25
BM25_K1=1.5
BM25_B=0.75

# LLM
LLM_TEMPERATURE=0.2

# Upload limits
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# API key auth — leave blank to disable (X-Api-Key header required when set)
API_KEY=
